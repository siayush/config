# ~/.zshrc

# Oh My Zsh
export ZSH="$HOME/.config/oh-my-zsh"
ZSH_THEME="robbyrussell"

# Skip compinit's permission audit
ZSH_DISABLE_COMPFIX="true"

# Load nvm lazily to keep startup fast.
zstyle ':omz:plugins:nvm' lazy yes

plugins=(git nvm zsh-autosuggestions zsh-syntax-highlighting)
source $ZSH/oh-my-zsh.sh

# Prompt
# robbyrussell, customized:
#   - "$" instead of the ➜ arrow (green on success, red on failure)
#   - no ✗ dirty marker (branch name only)
PROMPT="%(?:%{$fg_bold[green]%}\$:%{$fg_bold[red]%}\$%{$reset_color%}) %{$fg[cyan]%}%c%{$reset_color%}"
PROMPT+=' $(git_prompt_info)'
ZSH_THEME_GIT_PROMPT_DIRTY="%{$fg[blue]%})"

# PATH
export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="/opt/homebrew/opt/python@3.14/bin:$PATH"
export PATH="$PATH:$(go env GOPATH)/bin"

# make <bits/stdc++.h> available to clang
export CPATH="$HOME/.cpp-include:$CPATH"

# Homebrew
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_INSTALL_UPGRADE=1


# Starship
eval "$(starship init zsh)"

# Tools
# fzf key bindings and fuzzy completion
source <(fzf --zsh)

# Use fd as fzf's file source — respects .gitignore
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"


# Aliases
alias dp='docker compose up -d'
alias dd='docker compose down'
alias inv='nvim $(fd --type f --hidden --exclude .git | fzf -m --preview "bat --style=numbers --color=always {}")'
